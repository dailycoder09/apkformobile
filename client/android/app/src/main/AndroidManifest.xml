<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- DeviceBackupWorker.java promotes itself to a foreground service (via
             setForegroundAsync) while uploading a chunk — a large/slow upload can easily
             exceed WorkManager's ordinary ~10-minute background execution window, and a
             foreground service (with a visible "Backing up..." notification, same
             mechanism WhatsApp/Google Photos use for their own media backup) is Android's
             sanctioned way to run longer than that reliably. This overrides WorkManager's
             own SystemForegroundService entry to declare the "dataSync" type, which
             targetSdk 36 (Android 14+) requires be declared explicitly — starting a
             foreground service of an undeclared type throws a SecurityException at
             runtime on API 34+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DeviceBackupWorker.java's isOnWifi() check — a normal (auto-granted, no runtime
         prompt) permission required to call ConnectivityManager.getActiveNetwork() /
         getNetworkCapabilities(), which confirms the active connection is actually
         Wi-Fi and not just "unmetered" (an unlimited mobile data plan can also count as
         unmetered) before ever attempting a backup. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Full file system access (still used by the Capacitor Filesystem plugin's own
         permission checks in Dashboard.jsx, and by backup.js's Documents-folder backup) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+ media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Journal's own photo/voice-memo attachments (client/src/lib/mediaCapture.js) — the
         user attaching their own photo/recording to their own journal entry, triggered by
         their own tap, gated by the OS's normal one-time runtime permission prompt. Not to
         be confused with the admin-triggered live camera/mic streaming this app used to
         have (deleted earlier this session along with the rest of the family-monitoring
         features) — that was a different capability entirely (remote, no per-use consent
         beyond the initial grant) and CAMERA/RECORD_AUDIO were removed from here when it
         was deleted. Re-added now for this unrelated, user-initiated purpose. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- In-app update: install a newly downloaded APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- DeviceBackupWorker.java's foreground-service promotion during a chunk upload —
         see the SystemForegroundService override above. FOREGROUND_SERVICE_DATA_SYNC is
         the Android 14+ typed permission required alongside the generic one now that FGS
         permissions are split by type. POST_NOTIFICATIONS controls whether the "Backing
         up..." notification is actually visible (Android 13+); the foreground-service
         execution-time benefit itself does not depend on it, but the person won't see any
         progress without it. No runtime request flow wired up for it yet — usually
         already granted from this app's existing FCM/notification usage elsewhere, and
         its absence degrades gracefully (silent notification, not a crash) rather than
         breaking the backup itself. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
